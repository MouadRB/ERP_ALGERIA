PORT=4000
NODE_ENV=development
# Dev mode: bypass Keycloak for local BFF/WEB integration tests.
# Set to false only when Keycloak auth flow is fully configured and running.
USE_MOCK=false
AUTH_USE_MOCK=false

# Engine A (Java/Spring Boot) — OMS, Inventory, WMS, Logistics, PIM, Catalogue, Pricing, Promotions, MDM
ENGINE_A_URL=http://localhost:8082
MDM_URL=http://localhost:8081

# Engine B (C#/ASP.NET) — Finance, CRM, Procurement, Returns, Reconciliation
# Compose publishes engine-b on host port 8083 (8083:8080 in
# infrastructure/docker-compose/docker-compose.yml). When running engine-b
# standalone with `dotnet run`, ASP.NET binds to 5220 by default
# (see engine-b/Properties/launchSettings.json) — switch the value below.
ENGINE_B_URL=http://127.0.0.1:5220

# Shared HS256 secret — must match engine-b's `Jwt:Key` (or its ERP_JWT_SECRET
# env var) and engine-a's `app.security.jwt.secret`. The BFF uses this to mint
# short-lived service tokens so engine-b accepts cross-engine calls.
ERP_JWT_SECRET=changeme-in-production-use-256-bit-minimum-key-here-please
ENGINE_B_JWT_ISSUER=engine-b
ENGINE_B_JWT_AUDIENCE=erp-algeria-clients

# Keycloak
KEYCLOAK_REALM=ferza
KEYCLOAK_CLIENT_ID=ferza-bff
KEYCLOAK_ISSUER=http://localhost:8080/realms/ferza
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/ferza/protocol/openid-connect/certs

# Dev mock user — change this to test as different roles
# Valid values: SUPERADMIN | FINANCE_DIRECTOR | PRODUCT_MANAGER | INVENTORY_MANAGER
#               OMS_OPERATOR | CRM_AGENT | PROCUREMENT_MANAGER | CATALOGUE_MANAGER | ANALYST
MOCK_USER_ROLE=SUPERADMIN
MOCK_USER_ID=usr-dev-001
MOCK_USER_NAME_FR=Haroun
MOCK_USER_NAME_AR=هارون ر

# CORS — Next.js frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
