PORT=4000
NODE_ENV=development
USE_MOCK=true

# Engine A (Java/Spring Boot) — OMS, Inventory, WMS, Logistics, PIM, Catalogue, Pricing, Promotions, MDM
ENGINE_A_URL=http://localhost:8080

# Engine B (C#/ASP.NET) — Finance, CRM, Procurement, Returns, Reconciliation
ENGINE_B_URL=http://localhost:5000

# Keycloak
KEYCLOAK_REALM=ferza
KEYCLOAK_CLIENT_ID=ferza-bff
KEYCLOAK_ISSUER=http://localhost:8180/realms/ferza
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/ferza/protocol/openid-connect/certs

# Dev mock user — change this to test as different roles
# Valid values: SUPERADMIN | FINANCE_DIRECTOR | PRODUCT_MANAGER | INVENTORY_MANAGER
#               OMS_OPERATOR | CRM_AGENT | PROCUREMENT_MANAGER | CATALOGUE_MANAGER | ANALYST
MOCK_USER_ROLE=SUPERADMIN
MOCK_USER_ID=usr-dev-001
MOCK_USER_NAME_FR=Haroun
MOCK_USER_NAME_AR=هارون ر

# CORS — Next.js frontend
CORS_ORIGIN=http://localhost:5173,http://localhost:3000