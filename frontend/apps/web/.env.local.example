# SUPERADMIN | FINANCE_DIRECTOR | PRODUCT_MANAGER | INVENTORY_MANAGER
# OMS_OPERATOR | CRM_AGENT | PROCUREMENT_MANAGER | CATALOGUE_MANAGER | ANALYST
NEXT_PUBLIC_MOCK_USER_ROLE=SUPERADMIN
NEXT_PUBLIC_MOCK_USER_ID=usr-dev-001
NEXT_PUBLIC_MOCK_USER_NAME_FR=Haroun 
NEXT_PUBLIC_MOCK_USER_NAME_AR=هارون ر
